# SupportMesh Environment Configuration

# FastAPI Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database Settings
# Note: For running locally (outside Docker), replace 'postgres' with 'localhost'
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/supportmesh

# Groq LLM API Settings
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=gsk_your_actual_groq_api_key_goes_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Embeddings Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Webhook Settings
# Any HTTP endpoint that can accept POST requests (e.g. webhook.site, local mock, etc.)
WEBHOOK_URL=http://localhost:8000/tickets/webhook-demo-endpoint
